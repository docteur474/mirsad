# ─────────────── Binance (صلاحيات: قراءة بيانات — لا حاجة لتداول) ───────────────
BINANCE_API_KEY=your_binance_key
BINANCE_API_SECRET=your_binance_secret

# ─────────────── مصادر On-Chain والأخبار ───────────────
ARKHAM_API_KEY=your_arkham_key
WHALE_ALERT_API_KEY=your_whale_alert_key
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# ─────────────── بوت تيليجرام ───────────────
TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─────────────── نموذج وكيل المعنويات (المرحلة 1: قابل للضبط) ───────────────
# القيمة الافتراضية صالحة؛ بدّلها حسب مفاتيحك: claude-3-5-sonnet-20241022 / gpt-5.2
SENTIMENT_MODEL=claude-3-5-sonnet-20241022
